# Build/scratch output
*.log
/tmp/
__pycache__/

# Build artifact.
# LuoguMarkdownEditor.html is generated from index.html + src/ + assets/ by
# `node build-standalone.js`. It is published as a GitHub Release asset rather than
# committed, so that a one-line source change no longer produces a ~930 KB diff.
LuoguMarkdownEditor.html

# Desktop build outputs. The Rust target dir alone reaches hundreds of MB, and
# desktop/dist is a generated copy of LuoguMarkdownEditor.html.
desktop/dist/
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
