{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native file access for the workspace panel: pick files and folders, then read, write, create, rename and delete inside whatever the user chose.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "opener:allow-reveal-item-in-dir"
  ]
}
